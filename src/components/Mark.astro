---
// A marca é o campo do hero em miniatura: nove traços, e um deles
// aponta pra outro lado. É o "não é um template" desenhado.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---

<svg
  class={`mark ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  aria-hidden="true"
>
  <g class="m1"><path d="M4 8h6"></path></g>
  <g class="m2"><path d="M13 8h6"></path></g>
  <g class="m3"><path d="M22 8h6"></path></g>
  <g class="m4"><path d="M4 16h6"></path></g>
  <g class="m5 acc"><path d="M14 13l4 6"></path></g>
  <g class="m6"><path d="M22 16h6"></path></g>
  <g class="m7"><path d="M4 24h6"></path></g>
  <g class="m8"><path d="M13 24h6"></path></g>
  <g class="m9"><path d="M22 24h6"></path></g>
</svg>
