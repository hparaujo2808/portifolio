---
import { site, whatsappUrl } from '../config';
import Mark from './Mark.astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  t: any;
}

const { t } = Astro.props;
---

<section class="hero">
  <canvas class="field" id="field" aria-hidden="true"></canvas>
  <span class="hint">{t.hero.hint}</span>
  <div class="wrap">
    <h1>
      {t.hero.lines.map((l: string) => <span class="line"><span>{l}</span></span>)}
    </h1>
    <div class="hero-foot">
      <p>{t.hero.sub}</p>
      <div class="hero-cta">
        <span class="status"><i></i>{t.hero.status}</span>
        <a class="btn" href={whatsappUrl(t.hero.ctaText)} target="_blank" rel="noopener">
          {t.hero.cta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="section wrap" id="about">
  <h2>{t.about.title}</h2>
  <div class="about-grid">
    <figure class="portrait">
      <span class="ph"><Mark size={96} class="faint" /><small>{t.about.photoPh}</small></span>
      <img src="/henrique.jpg" alt={t.about.photoAlt} loading="lazy" onerror="this.remove()" />
    </figure>
    <div class="about-text">
      <p class="lead">{t.about.p1}</p>
      <p>{t.about.p2}</p>
      <p>{t.about.p3}</p>
      <div class="facts">
        {t.about.facts.map(([k, v]: [string, string]) => (
          <div>
            <span>{k}</span>
            <strong>{v}</strong>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section wrap" id="process">
  <h2>{t.process.title}</h2>
  <div class="steps" id="steps">
    <i class="fill" id="steps-fill"></i>
    <span class="steps-end"><Mark size={34} /></span>
    {t.process.steps.map((s: any) => (
      <article class="step">
        <span class="num">{s.label}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </article>
    ))}
  </div>
</section>

<section class="section wrap" id="services">
  <h2>{t.services.title}</h2>
  <div class="services">
    {t.services.items.map((s: any, i: number) => (
      <a class="service" href={whatsappUrl(s.ctaText)} target="_blank" rel="noopener">
        <ServiceIcon i={i} />
        <h3>
          {s.title}
          {s.tag && <span class="tag">{s.tag}</span>}
        </h3>
        <p>{s.text}</p>
        <span class="link">{t.services.link}</span>
      </a>
    ))}
  </div>
</section>

<section class="section wrap" id="faq">
  <div class="faq-grid">
    <div class="faq-side">
      <h2>{t.faq.title}</h2>
      <p class="small">{t.faq.note}</p>
      <a class="faq-link" href={whatsappUrl(t.faq.noteText)} target="_blank" rel="noopener">{t.faq.noteCta}</a>
    </div>
  <div class="faq">
    {t.faq.items.map((f: any) => (
      <details>
        <summary>
          {f.q}
          <span class="plus"></span>
        </summary>
        <div class="answer"><div><p>{f.a}</p></div></div>
      </details>
    ))}
  </div>
  </div>
</section>

<section class="section wrap" id="contact">
  <div class="contact" id="contact-card">
    <Mark size={240} class="big" />
    <h2>{t.contact.title}</h2>
    <p class="lead">{t.contact.text}</p>
    <div class="cta-row">
      <a class="btn big" href={whatsappUrl(t.contact.ctaText)} target="_blank" rel="noopener">
        {t.contact.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M7 17 17 7M9 7h8v8"></path>
        </svg>
      </a>
      <span class="email">
        <span>{t.contact.emailLabel}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </span>
    </div>
  </div>
</section>
