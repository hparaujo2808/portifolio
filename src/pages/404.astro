---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import { url } from '../config';
import t from '../content/pt';
---

<Layout t={t} title={t.notFound.metaTitle} noindex>
  <section class="section wrap page notfound">
    <Mark size={72} />
    <h1>{t.notFound.title}</h1>
    <p class="lead">{t.notFound.text}</p>
    <a class="btn" href={url('/')}>{t.notFound.cta}</a>
    <p class="small" lang="en">
      {t.notFound.en} <a class="text-link" href={url('/en/')}>{t.notFound.enCta}</a>
    </p>
  </section>
</Layout>
