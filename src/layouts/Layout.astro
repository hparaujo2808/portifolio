---
import '../styles/global.css';
import { site, whatsappUrl, url } from '../config';
import Mark from '../components/Mark.astro';

interface Props {
  t: any;
  title?: string;
  current?: 'about';
  // Caminho desta página em cada idioma (troca de idioma e hreflang).
  paths?: { pt: string; en: string };
}

const { t, title = t.meta.title, current, paths = { pt: '/', en: '/en/' } } = Astro.props;
const home = t.nav.home;
const switchHref = t.lang === 'en' ? paths.pt : paths.en;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="pt-BR" href={url(paths.pt)} />
    <link rel="alternate" hreflang="en" href={url(paths.en)} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="application-name" content={site.name} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Tema antes do primeiro paint, pra não piscar.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = saved || sys;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <header class="header" id="header">
      <div class="wrap">
        <a class="brand" href={url(home + '#top')} aria-label={site.name}>
          <Mark size={28} />
          <span class="brand-name">{site.name}</span>
        </a>
        <nav class="nav" aria-label="Principal">
          <a href={url(home + '#process')}>{t.nav.work}</a>
          <a href={url(home + '#services')}>{t.nav.services}</a>
          <a href={url(t.nav.aboutHref)} aria-current={current === 'about' ? 'page' : undefined}>{t.nav.about}</a>
          <a href={current ? '#contact' : url(home + '#contact')}>{t.nav.contact}</a>
        </nav>
        <div class="tools">
          <a class="chip" href={url(switchHref)} lang={t.nav.switchLang === 'EN' ? 'en' : 'pt-BR'}>
            {t.nav.switchLang}
          </a>
          <button class="theme-btn" id="theme" type="button" aria-label={t.nav.theme}>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
          <a class="chip solid" href={whatsappUrl(t.hero.ctaText)} target="_blank" rel="noopener">
            {t.nav.cta}
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="wrap footer">
      <span class="foot-brand"><Mark size={22} /> © {year} {site.name}. {t.footer.made}</span>
      <span class="foot-links">
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <a href="#top">{t.footer.top}</a>
      </span>
    </footer>

    <script>
      requestAnimationFrame(() => document.documentElement.classList.add('loaded'));

      // iOS só liga o :active se existir algum listener de toque.
      addEventListener('touchstart', () => {}, { passive: true });
      const reducedMq = matchMedia('(prefers-reduced-motion: reduce)');

      // FAQ: abre e fecha pelo mesmo caminho, e um toque no meio inverte
      // a partir de onde está (a transição CSS retoma do valor atual).
      document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
        const answer = d.querySelector<HTMLElement>('.answer');
        d.querySelector('summary')?.addEventListener('click', (e) => {
          if (!answer || reducedMq.matches) return;
          e.preventDefault();
          if (!d.open) {
            d.classList.add('shut');
            d.open = true;
            answer.offsetHeight;
            d.classList.remove('shut');
          } else {
            d.classList.toggle('shut');
          }
        });
        answer?.addEventListener('transitionend', (e) => {
          if (e.target === answer && d.classList.contains('shut')) {
            d.open = false;
            d.classList.remove('shut');
          }
        });
      });

      // Tema
      document.getElementById('theme')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // Header some ao descer, volta ao subir
      const header = document.getElementById('header');
      let last = 0;
      addEventListener(
        'scroll',
        () => {
          const y = scrollY;
          header?.classList.toggle('hide', y > last && y > 120);
          header?.classList.toggle('compact', y > 80);
          last = y;
        },
        { passive: true },
      );

      // Linha do processo preenche conforme você rola
      const steps = document.getElementById('steps');
      const fill = document.getElementById('steps-fill');
      if (steps && fill) {
        const items = Array.from(steps.querySelectorAll<HTMLElement>('.step'));
        const update = () => {
          const r = steps.getBoundingClientRect();
          const vertical = innerWidth <= 1000;
          const start = innerHeight * 0.92;
          const span = vertical ? Math.max(r.height, 1) : innerHeight * 0.3;
          const p = Math.min(1, Math.max(0, (start - r.top) / span));
          steps.style.setProperty('--p', String(p));
          items.forEach((el, i) => el.classList.toggle('on', p >= i / items.length + 0.02));
          steps.classList.toggle('done', p >= 1);
        };
        addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      }

      // Marca grande do contato: cada traço aponta pro cursor.
      const card = document.getElementById('contact-card');
      const big = card?.querySelector<SVGSVGElement>('.mark.big');
      const coarse = matchMedia('(pointer: coarse)').matches;
      if (card && big) {
        const groups = Array.from(big.querySelectorAll<SVGGElement>('g'));
        const base = groups.map((g) => (g.classList.contains('acc') ? 56 : 0));
        // Cada traço é uma mola (amortecimento 0.8, resposta 0.4s, os valores
        // da Apple pra rotação). O alvo é desenrolado pro lado mais curto,
        // então cruzar a esquerda do traço não faz ele dar a volta inteira.
        const cur = groups.map(() => 0);
        const vel = groups.map(() => 0);
        const tgt = groups.map(() => 0);
        const W0 = (2 * Math.PI) / 0.4;
        const ZETA = 0.8;
        let running = false;
        let prev = 0;
        const step = (now: number) => {
          const dt = Math.min(0.032, (now - prev) / 1000);
          prev = now;
          let moving = false;
          groups.forEach((g, i) => {
            const a = -W0 * W0 * (cur[i] - tgt[i]) - 2 * ZETA * W0 * vel[i];
            vel[i] += a * dt;
            cur[i] += vel[i] * dt;
            if (Math.abs(vel[i]) > 0.5 || Math.abs(cur[i] - tgt[i]) > 0.1) moving = true;
            else (cur[i] = tgt[i]), (vel[i] = 0);
            g.style.transform = `rotate(${cur[i]}deg)`;
          });
          running = moving;
          if (moving) requestAnimationFrame(step);
        };
        const kick = () => {
          if (running) return;
          if (reducedMq.matches) {
            groups.forEach((g, i) => ((cur[i] = tgt[i]), (g.style.transform = `rotate(${cur[i]}deg)`)));
            return;
          }
          running = true;
          prev = performance.now();
          requestAnimationFrame(step);
        };
        const nearest = (i: number, deg: number) => cur[i] + ((((deg - cur[i]) % 360) + 540) % 360) - 180;
        const aim = (x: number, y: number) => {
          groups.forEach((g, i) => {
            const r = g.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            const ang = (Math.atan2(y - cy, x - cx) * 180) / Math.PI;
            tgt[i] = nearest(i, ang - base[i]);
          });
          kick();
        };
        if (coarse) {
          // Sem cursor: os traços chegam espalhados, como o campo do hero, e
          // se encaixam um a um quando o cartão aparece. Termina sempre na marca.
          // Saiu da tela, espalha de novo (fora de vista) pra montar na volta.
          if (!reducedMq.matches) {
            const scatter = [70, -55, 115, -80, 150, 40, -120, 95, -35];
            let timers: number[] = [];
            let built = false;
            const spread = () => {
              timers.forEach(clearTimeout);
              timers = [];
              built = false;
              groups.forEach((g, i) => {
                cur[i] = tgt[i] = scatter[i % scatter.length];
                vel[i] = 0;
                g.style.transform = `rotate(${cur[i]}deg)`;
              });
            };
            const build = () => {
              built = true;
              timers = groups.map((_, i) =>
                window.setTimeout(() => {
                  tgt[i] = 0;
                  kick();
                }, 120 + i * 70),
              );
            };
            spread();
            new IntersectionObserver(
              ([e]) => {
                if (!e.isIntersecting) spread();
                else if (!built && e.intersectionRatio >= 0.45) build();
              },
              { threshold: [0, 0.45] },
            ).observe(card);
          }
        } else {
          card.addEventListener('pointermove', (e) => aim(e.clientX, e.clientY));
          card.addEventListener('pointerleave', () => {
            groups.forEach((_, i) => (tgt[i] = nearest(i, 0)));
            kick();
          });
        }
      }

      // ------------------------------------------------------------
      // Campo de linhas do hero. Cada traço aponta pra onde o
      // fluxo manda; o cursor dobra o fluxo e o clique manda uma onda.
      // ------------------------------------------------------------
      const canvas = document.getElementById('field') as HTMLCanvasElement | null;
      const reduced = reducedMq.matches;

      if (canvas) {
        const ctx = canvas.getContext('2d')!;
        const hero = canvas.parentElement!;
        let W = 0, H = 0, dpr = 1, cols = 0, rows = 0;
        const GAP = 26;
        const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999 };
        const waves: { x: number; y: number; t: number }[] = [];

        const resize = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          W = hero.clientWidth;
          H = hero.clientHeight;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          canvas.style.width = W + 'px';
          canvas.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          cols = Math.ceil(W / GAP) + 1;
          rows = Math.ceil(H / GAP) + 1;
        };

        const color = () => {
          const s = getComputedStyle(document.documentElement);
          return { field: s.getPropertyValue('--field').trim(), accent: s.getPropertyValue('--accent').trim() };
        };

        let c = color();
        const obs = new MutationObserver(() => (c = color()));
        obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

        // Celular: sem cursor, o foco deriva sozinho e a inclinação do
        // aparelho desloca ele. iOS pede permissão num toque.
        let tilt: { x: number; y: number } | null = null;
        const onTilt = (e: DeviceOrientationEvent) => {
          if (e.gamma == null || e.beta == null) return;
          tilt = { x: Math.max(-1, Math.min(1, e.gamma / 30)), y: Math.max(-1, Math.min(1, (e.beta - 45) / 30)) };
        };
        const askTilt = () => {
          const D = DeviceOrientationEvent as any;
          if (typeof D?.requestPermission === 'function') {
            D.requestPermission().then((s: string) => {
              if (s === 'granted') addEventListener('deviceorientation', onTilt);
            }).catch(() => {});
          } else {
            addEventListener('deviceorientation', onTilt);
          }
        };
        if (coarse) {
          hero.addEventListener('pointerdown', askTilt, { once: true });
        } else {
          hero.addEventListener('pointermove', (e) => {
            const r = canvas.getBoundingClientRect();
            mouse.tx = e.clientX - r.left;
            mouse.ty = e.clientY - r.top;
          });
          hero.addEventListener('pointerleave', () => {
            mouse.tx = -9999;
            mouse.ty = -9999;
          });
        }
        hero.addEventListener('pointerdown', (e) => {
          const r = canvas.getBoundingClientRect();
          waves.push({ x: e.clientX - r.left, y: e.clientY - r.top, t: 0 });
        });

        const noise = (x: number, y: number, t: number) =>
          Math.sin(x * 0.9 + t * 0.6) * Math.cos(y * 0.7 - t * 0.4) +
          Math.sin((x + y) * 0.35 + t * 0.25) * 0.6;

        let t0 = performance.now();
        let last = t0;
        let visible = true;
        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

        const frame = (now: number) => {
          requestAnimationFrame(frame);
          const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
          last = now;
          if (!visible) return;
          const t = (now - t0) / 1000;
          // Mesmo seguimento de antes (12% por quadro a 60 Hz), mas por tempo.
          const follow = 1 - Math.exp(-dt / 0.13);

          if (coarse) {
            const dx = tilt ? tilt.x * W * 0.35 : 0;
            const dy = tilt ? tilt.y * H * 0.25 : 0;
            mouse.tx = W * (0.5 + 0.3 * Math.sin(t * 0.35)) + dx;
            mouse.ty = H * (0.42 + 0.22 * Math.cos(t * 0.27)) + dy;
          }
          mouse.x += (mouse.tx - mouse.x) * follow;
          mouse.y += (mouse.ty - mouse.y) * follow;

          ctx.clearRect(0, 0, W, H);
          ctx.lineCap = 'round';

          for (let i = waves.length - 1; i >= 0; i--) {
            waves[i].t += dt;
            if (waves[i].t > 2.2) waves.splice(i, 1);
          }

          for (let j = 0; j < rows; j++) {
            for (let i = 0; i < cols; i++) {
              const x = i * GAP;
              const y = j * GAP;

              let a = noise(x / 140, y / 140, t) * Math.PI;
              let len = 9;
              let alpha = 0.16;
              let mix = 0;

              const dx = x - mouse.x;
              const dy = y - mouse.y;
              const d = Math.hypot(dx, dy);
              if (d < 260) {
                const k = 1 - d / 260;
                const kk = k * k;
                a = a * (1 - kk) + Math.atan2(dy, dx) * kk;
                len += 10 * kk;
                alpha += 0.6 * kk;
                mix = kk;
              }

              for (const w of waves) {
                const wd = Math.hypot(x - w.x, y - w.y);
                const ring = Math.abs(wd - w.t * 420);
                if (ring < 70) {
                  const k = (1 - ring / 70) * Math.max(0, 1 - w.t / 2.2);
                  len += 12 * k;
                  alpha += 0.5 * k;
                  mix = Math.max(mix, k);
                }
              }

              const cx = Math.cos(a) * len * 0.5;
              const cy = Math.sin(a) * len * 0.5;

              ctx.strokeStyle = mix > 0.05 ? c.accent : `rgba(${c.field},1)`;
              ctx.globalAlpha = Math.min(alpha, 0.95);
              ctx.lineWidth = 1 + mix * 0.8;
              ctx.beginPath();
              ctx.moveTo(x - cx, y - cy);
              ctx.lineTo(x + cx, y + cy);
              ctx.stroke();
            }
          }
          ctx.globalAlpha = 1;
        };

        resize();
        addEventListener('resize', resize);
        if (reduced) {
          frame(performance.now() + 1);
        } else {
          requestAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
